{
  "name": "di-framework",
  "version": "4.0.3",
  "module": "build.ts",
  "type": "module",
  "author": "@di-framework Contributors",
  "license": "MIT",
  "repository": "https://github.com/di-framework/di-framework",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples",
    "examples/packages/*"
  ],
  "scripts": {
    "build": "bun run packages/di-framework-cli/cmd/build.ts",
    "test:all": "bun --filter=* run test",
    "test": "bun test",
    "publish": "bun run packages/di-framework-cli/cmd/publish.ts",
    "link-cli": "(cd packages/di-framework-cli && bun link >/dev/null 2>&1)",
    "postinstall": "git config core.hooksPath .githooks && bun link-cli && echo 'di-framework <command> [args...]'",
    "tsc": "tsc",
    "lint": "biome check .",
    "typecheck": "bun x tsc -b --noEmit",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "release:patch": "gh workflow run auto-tag.yml -f bump=patch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "bun-types": "1.3.14",
    "happy-dom": "^20.11.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
