{
  "name": "di-framework",
  "version": "5.2.9",
  "module": "build.ts",
  "type": "module",
  "author": "@di-framework Contributors",
  "license": "(MIT OR Apache-2.0)",
  "repository": "https://github.com/di-framework/di-framework",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples",
    "examples/packages/*"
  ],
  "scripts": {
    "build": "bun run packages/di-framework-cli/main.ts mx build",
    "check-packaging": "bun scripts/check-package-tarballs.ts",
    "check-package-tarballs": "bun scripts/check-package-tarballs.ts",
    "check-ai-utils-optional-peer": "bun scripts/check-ai-utils-optional-peer.ts",
    "release:dry-run": "bun run packages/di-framework-cli/main.ts mx build --sync-versions && bun scripts/release-prepublish.ts --publish-dry-run",
    "test:all": "bun --filter='./packages/*' --filter='./examples' --filter='./examples/packages/*' --sequential run test",
    "test": "bun test",
    "publish": "bun run packages/di-framework-cli/main.ts mx publish",
    "link-cli": "(cd packages/di-framework-cli && bun link >/dev/null 2>&1)",
    "postinstall": "git config core.hooksPath .githooks && bun link-cli && bun run build && echo 'di-framework init | build | check  (mx: maintainers)'",
    "tsc": "tsc",
    "lint": "biome check .",
    "typecheck": "bun x tsc --noEmit",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "release:patch": "gh workflow run auto-tag.yml -f bump=patch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "latest",
    "bun-types": "1.3.14",
    "happy-dom": "^20.11.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
