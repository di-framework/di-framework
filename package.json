{
  "name": "di-framework",
  "version": "3.0.1",
  "module": "build.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "./packages/bin",
    "./packages/examples",
    "./packages/di-framework",
    "./packages/di-framework-http",
    "./packages/di-framework-repo"
  ],
  "scripts": {
    "build": "bun run packages/bin/cmd/build.ts",
    "test:all": "bun --filter=* run test",
    "test": "bun test",
    "publish": "bun run packages/bin/cmd/publish.ts",
    "link-cli": "(cd packages/bin && bun link >/dev/null 2>&1)",
    "postinstall": "git config core.hooksPath .githooks && bun link-cli && echo 'di-framework <command> [args...]'",
    "tsc": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "happy-dom": "^20.11.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
