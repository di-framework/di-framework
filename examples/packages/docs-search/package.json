{
  "name": "@di-framework/docs-search-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Writerside docs search on Cloudflare Workers — showcase of @di-framework/core + repo + Workers AI",
  "scripts": {
