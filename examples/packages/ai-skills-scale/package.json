{
  "name": "@di-framework/ai-skills-scale-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Large-catalog Agent Skills selection experiment for @di-framework/ai-utils",
  "scripts": {
    "fetch": "bun src/fetch.ts",
    "materialize:gitskills": "bun src/materialize-gitskills.ts",
    "index": "bun src/build-index.ts",
    "retrieve": "bun src/retrieve.ts",
    "compare": "bun src/retrieve.ts --compare",
    "start": "bun src/main.ts",
    "live": "bun src/main.ts --live",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun src/build-index.ts --if-present && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@di-framework/ai": "workspace:*",
    "@di-framework/ai-utils": "workspace:*",
    "@di-framework/core": "workspace:*",
    "@di-framework/examples-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
