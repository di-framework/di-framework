{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["bun"],
    "types": ["bun"],
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "allowImportingTsExtensions": true,
    "plugins": [{ "transform": "@di-framework/tsc" }]
  },
  "include": [
    "packages/advanced/**/*.ts",
    "packages/basic/**/*.ts",
    "packages/graphql/**/*.ts",
    "packages/http-router/**/*.ts",
    "packages/services/**/*.ts",
    "packages/shared/**/*.ts",
    "packages/test-example/**/*.ts",
    "packages/cf-worker/**/*.ts",
    "packages/ai-chat/**/*.ts",
    "packages/ai-skills/**/*.ts",
    "packages/ai-skills-scale/**/*.ts",
    "packages/auth/**/*.ts",
    "packages/authz/**/*.ts",
    "packages/config/**/*.ts",
    "packages/events/**/*.ts",
    "packages/docs-search/**/*.ts",
    "packages/init-tsc-inspect/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/*.test.ts",
    "packages/deno-http/**/*",
    "packages/deno-sandboxes/**/*"
  ]
}
