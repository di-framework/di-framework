/**
 * Isolated local wasmCloud platform. This program owns the cluster, registry,
 * wasmCloud operator, and the deploy-controller WorkloadDeployment. Application
 * WorkloadDeployments are written only by that controller after `wasmcloud login`.
 */
import { createHash } from 'node:crypto';
import * as path from 'node:path';
import * as command from '@pulumi/command';
import * as k8s from '@pulumi/kubernetes';
import * as pulumi from '@pulumi/pulumi';

const K0S_IMAGE = 'docker.io/k0sproject/k0s:v1.36.3-k0s.2';
const REGISTRY_IMAGE = 'docker.io/library/registry:3.1.1';
const WASMCLOUD_OPERATOR_VERSION = '2.8.0';
const REGISTRY_NODE_PORT = 30500;
const HTTP_NODE_PORT = 30180;
const namespaceName = 'wasmcloud';
const ownershipLabel = 'di-framework.dev.platform-scope';

const config = new pulumi.Config();
const apiPort = hostPort(config, 'apiPort', 26443);
const registryPort = hostPort(config, 'registryPort', 25000);
const httpPort = hostPort(config, 'httpPort', 28180);
if (new Set([apiPort, registryPort, httpPort]).size !== 3) {
  throw new Error('apiPort, registryPort, and httpPort must be distinct');
}

const stack = sanitize(pulumi.getStack());
const projectHash = createHash('sha256').update(pulumi.getProject()).digest('hex').slice(0, 10);
const scope = `di-framework-${stack}-${projectHash}`;
const networkName = `${scope}-network`;
const k0sName = `${scope}-k0s`;
const k0sDataName = `${scope}-k0s-data`;
const k0sPodLogsName = `${scope}-k0s-pod-logs`;
const kubeconfigFile = path.resolve(`.kubeconfig-${stack}`);

const runtimeNetwork = new command.local.Command('runtime-network', {
  create: refuseExistingNetworkThenCreate(networkName),
  delete: deleteOwnedNetwork(networkName),
});

const k0sData = new command.local.Command('k0s-data', {
  create: refuseExistingVolumeThenCreate(k0sDataName),
  delete: deleteOwnedVolume(k0sDataName),
});

const k0sPodLogs = new command.local.Command('k0s-pod-logs', {
  create: refuseExistingVolumeThenCreate(k0sPodLogsName),
  delete: deleteOwnedVolume(k0sPodLogsName),
});

const k0s = new command.local.Command(
  'k0s',
  {
    create: [
      'set -eu;',
      `if docker container inspect ${k0sName} >/dev/null 2>&1; then`,
      `echo "Refusing to replace existing container ${k0sName}" >&2; exit 1; fi;`,
      'docker run -d',
      `--name ${k0sName}`,
      `--hostname ${k0sName}`,
      `--label ${ownershipLabel}=${scope}`,
      `--network ${networkName}`,
      '--privileged',
      '--tmpfs /run:rw,nosuid,nodev,exec,mode=755',
      `--mount type=volume,source=${k0sDataName},target=/var/lib/k0s`,
      `--mount type=volume,source=${k0sPodLogsName},target=/var/log/pods`,
      `--publish 127.0.0.1:${apiPort}:6443`,
      `--publish 127.0.0.1:${registryPort}:${REGISTRY_NODE_PORT}`,
      `--publish 127.0.0.1:${httpPort}:${HTTP_NODE_PORT}`,
      K0S_IMAGE,
      'k0s controller --enable-worker --no-taints',
    ].join(' '),
    delete: deleteOwnedContainer(k0sName),
  },
  {
    dependsOn: [runtimeNetwork, k0sData, k0sPodLogs],
    deleteBeforeReplace: true,
  },
);

const kubeconfigCommand = new command.local.Command(
  'kubeconfig',
  {
    create: [
      'set -eu;',
      'attempt=0;',
      `until docker exec ${k0sName} k0s kubectl get --raw=/readyz >/dev/null 2>&1 &&`,
      `docker exec ${k0sName} k0s kubectl wait node --all --for=condition=Ready --timeout=5s >/dev/null 2>&1; do`,
      'attempt=$((attempt + 1));',
      `if [ "$attempt" -ge 90 ]; then docker logs --tail 200 ${k0sName} >&2; exit 1; fi;`,
      'sleep 2;',
      'done;',
      `docker exec ${k0sName} k0s kubeconfig admin |`,
      `sed -E 's#server: https://[^:]+:6443#server: https://127.0.0.1:${apiPort}#'`,
    ].join(' '),
    logging: command.types.enums.local.Logging.None,
  },
  { dependsOn: [k0s], additionalSecretOutputs: ['stdout'] },
);

const kubeconfigContents = pulumi.secret(kubeconfigCommand.stdout);
const kubeconfigFileCommand = new command.local.Command(
  'kubeconfig-file',
  {
    create: 'umask 077; printf "%s\\n" "$KUBECONFIG_CONTENT" > "$KUBECONFIG_FILE"',
    update: 'umask 077; printf "%s\\n" "$KUBECONFIG_CONTENT" > "$KUBECONFIG_FILE"',
    delete: 'if [ -n "$KUBECONFIG_FILE" ]; then rm -f -- "$KUBECONFIG_FILE"; fi',
    environment: {
      KUBECONFIG_CONTENT: kubeconfigContents,
      KUBECONFIG_FILE: kubeconfigFile,
    },
    logging: command.types.enums.local.Logging.None,
  },
  { dependsOn: [kubeconfigCommand] },
);

const provider = new k8s.Provider(
  'k0s',
  { kubeconfig: kubeconfigContents, enableServerSideApply: true },
  { dependsOn: [kubeconfigCommand] },
);

const namespaceResource = new k8s.core.v1.Namespace(
  'wasmcloud',
  {
    metadata: {
      name: namespaceName,
      // Every namespaced resource has already been deleted when the isolated
      // cluster is torn down; do not block k0s cleanup on namespace GC.
      annotations: { 'pulumi.com/skipAwait': 'true' },
    },
  },
  { provider },
);

const registryLabels = { 'app.kubernetes.io/name': 'di-framework-registry' };
const registryDeployment = new k8s.apps.v1.Deployment(
  'oci-registry',
  {
    metadata: { name: 'di-framework-registry', namespace: namespaceName },
    spec: {
      replicas: 1,
      selector: { matchLabels: registryLabels },
      template: {
        metadata: { labels: registryLabels },
        spec: {
          containers: [
            {
              name: 'registry',
              image: REGISTRY_IMAGE,
              ports: [{ name: 'registry', containerPort: 5000 }],
              readinessProbe: { httpGet: { path: '/v2/', port: 'registry' } },
              volumeMounts: [{ name: 'data', mountPath: '/var/lib/registry' }],
            },
          ],
          volumes: [
            {
              name: 'data',
              hostPath: {
                path: `/var/lib/k0s/di-framework/${scope}/registry`,
                type: 'DirectoryOrCreate',
              },
            },
          ],
        },
      },
    },
  },
  { provider, dependsOn: [namespaceResource] },
);

const registryService = new k8s.core.v1.Service(
  'oci-registry',
  {
    metadata: { name: 'di-framework-registry', namespace: namespaceName },
    spec: {
      type: 'NodePort',
      selector: registryLabels,
      ports: [
        {
          name: 'registry',
          port: 5000,
          targetPort: 'registry',
          nodePort: REGISTRY_NODE_PORT,
        },
      ],
    },
  },
  { provider, dependsOn: [registryDeployment] },
);

const wasmcloud = new k8s.helm.v3.Release(
  'wasmcloud',
  {
    name: 'wasmcloud',
    namespace: namespaceName,
    createNamespace: false,
    chart: 'oci://ghcr.io/wasmcloud/charts/runtime-operator',
    version: WASMCLOUD_OPERATOR_VERSION,
    atomic: true,
    cleanupOnFail: true,
    timeout: 600,
    values: {
      gateway: { enabled: false },
      runtime: {
        extraArgs: ['--allow-insecure-registries'],
        resources: {
          requests: { cpu: '250m', memory: '256Mi' },
          limits: { memory: '2Gi' },
          defaultHeapMemory: '512MiB',
          coreInstances: '100',
        },
        hostGroups: [
          {
            name: 'default',
            replicas: 1,
            service: { type: 'ClusterIP' },
            webgpu: { enabled: false },
            http: { enabled: true, port: 9191 },
          },
        ],
      },
    },
  },
  { provider, dependsOn: [namespaceResource, registryService] },
);

const runtimeShutdown = new command.local.Command(
  'runtime-shutdown',
  {
    create: 'true',
    delete: [
      'set -eu;',
      'docker exec "$K0S_NAME" k0s kubectl --namespace "$NAMESPACE"',
      'delete deployment/hostgroup-default',
      '--ignore-not-found=true --wait=true --timeout=180s;',
      'docker exec "$K0S_NAME" k0s kubectl --namespace "$NAMESPACE"',
      'delete hosts.runtime.wasmcloud.dev --all',
      '--ignore-not-found=true --wait=true --timeout=180s',
    ].join(' '),
    environment: { K0S_NAME: k0sName, NAMESPACE: namespaceName },
  },
  { dependsOn: [wasmcloud, kubeconfigFileCommand] },
);

new k8s.core.v1.Service(
  'http-entrypoint',
  {
    metadata: { name: 'wasmcloud-http', namespace: namespaceName },
    spec: {
      type: 'NodePort',
      selector: {
        'wasmcloud.com/hostgroup': 'default',
        'wasmcloud.com/name': 'hostgroup',
      },
      ports: [
        { name: 'http', port: 80, targetPort: 9191, nodePort: HTTP_NODE_PORT, protocol: 'TCP' },
      ],
    },
  },
  { provider, dependsOn: [runtimeShutdown] },
);

const controllerImage =
  config.get('controllerImage') ??
  `di-framework-registry.${namespaceName}.svc.cluster.local:5000/wasmcloud-controller:local`;
const bootstrapPassword = config.get('bootstrapPassword') ?? 'local-admin';
const controllerLabels = {
  'app.kubernetes.io/managed-by': 'di-framework',
  'app.kubernetes.io/name': 'deploy',
  'di-framework.dev/application': 'deploy',
  'di-framework.dev/org': 'local',
  'di-framework.dev/team': 'platform',
  'di-framework.dev/owner': 'admin',
};

const controllerServiceAccount = new k8s.core.v1.ServiceAccount(
  'deploy-controller',
  { metadata: { name: 'deploy-controller', namespace: namespaceName } },
  { provider, dependsOn: [namespaceResource] },
);

const controllerRole = new k8s.rbac.v1.Role(
  'deploy-controller',
  {
    metadata: { name: 'deploy-controller', namespace: namespaceName },
    rules: [
      {
        apiGroups: ['runtime.wasmcloud.dev'],
        resources: ['workloaddeployments'],
        verbs: ['get', 'list', 'create', 'update', 'patch', 'delete'],
      },
      {
        apiGroups: [''],
        resources: ['services', 'secrets'],
        verbs: ['get', 'list', 'create', 'update', 'patch', 'delete'],
      },
      {
        apiGroups: ['batch'],
        resources: ['cronjobs'],
        verbs: ['get', 'list', 'create', 'update', 'patch', 'delete'],
      },
    ],
  },
  { provider, dependsOn: [namespaceResource] },
);

new k8s.rbac.v1.RoleBinding(
  'deploy-controller',
  {
    metadata: { name: 'deploy-controller', namespace: namespaceName },
    roleRef: { apiGroup: 'rbac.authorization.k8s.io', kind: 'Role', name: 'deploy-controller' },
    subjects: [{ kind: 'ServiceAccount', name: 'deploy-controller', namespace: namespaceName }],
  },
  { provider, dependsOn: [controllerRole, controllerServiceAccount] },
);

const controllerConfig = new k8s.core.v1.ConfigMap(
  'deploy-controller',
  {
    metadata: { name: 'deploy-platform', namespace: namespaceName, labels: controllerLabels },
    data: {
      namespace: namespaceName,
      kubeApi: 'https://kubernetes.default.svc',
      issuer: `http://127.0.0.1:${httpPort}`,
      bootstrapUser: 'admin',
      members: JSON.stringify({ admin: { org: 'local', team: 'platform', roles: ['org-admin'] } }),
    },
  },
  { provider, dependsOn: [namespaceResource] },
);

const controllerToken = new k8s.core.v1.Secret(
  'deploy-controller-token',
  {
    metadata: {
      name: 'deploy-controller-token',
      namespace: namespaceName,
      annotations: { 'kubernetes.io/service-account.name': 'deploy-controller' },
      labels: controllerLabels,
    },
    type: 'kubernetes.io/service-account-token',
  },
  { provider, dependsOn: [controllerServiceAccount] },
);

const controllerSecrets = new k8s.core.v1.Secret(
  'deploy-controller-secrets',
  {
    metadata: { name: 'deploy-tokens', namespace: namespaceName, labels: controllerLabels },
    stringData: {
      bootstrapPassword,
      kubeToken: '',
    },
  },
  { provider, dependsOn: [namespaceResource] },
);

const controllerService = new k8s.core.v1.Service(
  'deploy-controller',
  {
    metadata: { name: 'deploy', namespace: namespaceName, labels: controllerLabels },
    spec: {
      type: 'ClusterIP',
      ports: [{ name: 'http', port: 80, targetPort: 80, protocol: 'TCP' }],
    },
  },
  { provider, dependsOn: [namespaceResource] },
);

new k8s.apiextensions.CustomResource(
  'deploy-controller',
  {
    apiVersion: 'runtime.wasmcloud.dev/v1alpha1',
    kind: 'WorkloadDeployment',
    metadata: { name: 'deploy', namespace: namespaceName, labels: controllerLabels },
    spec: {
      replicas: 1,
      template: {
        spec: {
          hostSelector: { hostgroup: 'default' },
          kubernetes: { service: { name: 'deploy' } },
          components: [
            {
              name: 'deploy',
              image: controllerImage,
              localResources: {
                environment: {
                  config: {
                    DI_CONTROL_REJECT_FORWARDED: '1',
                    DI_CONTROL_HTTP_HOST: 'deploy',
                  },
                },
                allowedIpNameLookups: [
                  'kubernetes.default.svc',
                  'kubernetes.default.svc.cluster.local',
                ],
              },
              hostInterfaces: [
                {
                  namespace: 'wasi',
                  package: 'http',
                  version: '0.3.0',
                  interfaces: ['handler'],
                  config: { host: 'deploy' },
                },
                {
                  namespace: 'wasi',
                  package: 'config',
                  version: '0.2.0-rc.1',
                  interfaces: ['store'],
                  configFrom: [{ name: 'deploy-platform' }],
                },
                {
                  namespace: 'wasmcloud',
                  package: 'secrets',
                  version: '2.1.0',
                  interfaces: ['store', 'reveal'],
                  secretFrom: [{ name: 'deploy-tokens' }, { name: 'deploy-controller-token' }],
                },
              ],
            },
          ],
        },
      },
    },
  },
  { provider, dependsOn: [wasmcloud, controllerConfig, controllerSecrets, controllerToken, controllerService] },
);

export const schemaVersion = 2;
export const kubeconfig = kubeconfigFileCommand.id.apply(() => kubeconfigFile);
export const namespace = namespaceResource.metadata.name;
export const registry = {
  push: `http://127.0.0.1:${registryPort}`,
  pull: `di-framework-registry.${namespaceName}.svc.cluster.local:5000`,
  insecure: true,
};
export const endpoints = {
  http: `http://127.0.0.1:${httpPort}`,
  kubernetes: `https://127.0.0.1:${apiPort}`,
  registry: `http://127.0.0.1:${registryPort}`,
};
export const controller = {
  url: `http://127.0.0.1:${httpPort}`,
  host: 'deploy',
};

function hostPort(configuration: pulumi.Config, name: string, fallback: number): number {
  const value = configuration.getNumber(name) ?? fallback;
  if (!Number.isInteger(value) || value < 1024 || value > 65535) {
    throw new Error(`${name} must be an integer from 1024 through 65535; received ${value}`);
  }
  return value;
}

function sanitize(value: string): string {
  const sanitized = value.toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '');
  return sanitized || 'stack';
}

function refuseExistingNetworkThenCreate(name: string): string {
  return [
    'set -eu;',
    `if docker network inspect ${name} >/dev/null 2>&1; then`,
    `echo "Refusing to replace existing network ${name}" >&2; exit 1; fi;`,
    `docker network create --label ${ownershipLabel}=${scope} ${name}`,
  ].join(' ');
}

function refuseExistingVolumeThenCreate(name: string): string {
  return [
    'set -eu;',
    `if docker volume inspect ${name} >/dev/null 2>&1; then`,
    `echo "Refusing to replace existing volume ${name}" >&2; exit 1; fi;`,
    `docker volume create --label ${ownershipLabel}=${scope} ${name}`,
  ].join(' ');
}

function deleteOwnedContainer(name: string): string {
  return [
    `owner="$(docker container inspect --format '{{ index .Config.Labels "${ownershipLabel}" }}' ${name} 2>/dev/null || true)";`,
    `[ "$owner" != "${scope}" ] || docker container rm --force ${name}`,
  ].join(' ');
}

function deleteOwnedNetwork(name: string): string {
  return [
    `owner="$(docker network inspect --format '{{ index .Labels "${ownershipLabel}" }}' ${name} 2>/dev/null || true)";`,
    `[ "$owner" != "${scope}" ] || docker network rm ${name}`,
  ].join(' ');
}

function deleteOwnedVolume(name: string): string {
  return [
    `owner="$(docker volume inspect --format '{{ index .Labels "${ownershipLabel}" }}' ${name} 2>/dev/null || true)";`,
    `[ "$owner" != "${scope}" ] || docker volume rm ${name}`,
  ].join(' ');
}
