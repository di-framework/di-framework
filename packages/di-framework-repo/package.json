{
  "name": "@di-framework/repo",
  "version": "6.0.5",
  "description": "A coherent abstraction of repositories and storage adapters for di-framework.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "type": "module",
  "license": "(MIT OR Apache-2.0)",
  "author": "@di-framework Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/di-framework",
    "directory": "packages/di-framework-repo"
  },
  "bugs": {
    "url": "https://github.com/di-framework/di-framework/issues"
  },
  "homepage": "https://github.com/di-framework/di-framework#readme",
  "scripts": {
    "test": "bun test",
    "build": "rm -rf dist && bun x tsc -p tsconfig.build.json && bun ../di-framework-cli/scripts/fix-esm-imports.ts dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "wasmcloud": "./dist/portable.js",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "default": "./dist/portable.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "wasmcloud": "./dist/postgres.js",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    }
  },
  "peerDependencies": {
    "@di-framework/core": "^6",
    "typescript": "^5"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
