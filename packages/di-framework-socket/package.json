{
  "name": "@di-framework/socket",
  "version": "4.2.2",
  "description": "Decorator-driven WebSocket, TCP, and UDP for di-framework — @SocketGateway / @OnMessage with a WebCrypto secure channel",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "bun": "./dist/node.js",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "bun": "./dist/bun.js",
      "import": "./dist/bun.js",
      "default": "./dist/bun.js"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
      "bun": "./dist/graphql.js",
      "import": "./dist/graphql.js",
      "default": "./dist/graphql.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "bun": "./dist/workers.js",
      "import": "./dist/workers.js",
      "default": "./dist/workers.js"
    }
  },
  "author": "@di-framework Contributors",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/di-framework",
    "directory": "packages/di-framework-socket"
  },
  "bugs": {
    "url": "https://github.com/di-framework/di-framework/issues"
  },
  "homepage": "https://github.com/di-framework/di-framework#readme",
  "keywords": [
    "websocket",
    "tcp",
    "udp",
    "socket",
    "encryption",
    "ecdh",
    "aead",
    "dependency-injection",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./index.ts ./node.ts ./bun.ts ./graphql.ts ./workers.ts --outdir ./dist --target node --external @di-framework/core --external ws && tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@di-framework/core": "workspace:*",
    "typescript": "^5"
  }
}
