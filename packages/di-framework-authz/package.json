{
  "name": "@di-framework/authz",
  "version": "4.2.2",
  "description": "Declarative resource authorization policies for di-framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "bun": "./dist/http.js",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
      "bun": "./dist/graphql.js",
      "import": "./dist/graphql.js",
      "default": "./dist/graphql.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./index.ts ./http.ts ./graphql.ts --outdir ./dist --target node --splitting --external @di-framework/core --external @di-framework/auth && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@di-framework/auth": "workspace:*",
    "@di-framework/core": "workspace:*",
    "@di-framework/http": "workspace:*",
    "typescript": "^5"
  },
  "devDependencies": {
    "@di-framework/auth": "workspace:*",
    "@di-framework/core": "workspace:*",
    "@di-framework/http": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@di-framework/http": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/di-framework",
    "directory": "packages/di-framework-authz"
  },
  "license": "(MIT OR Apache-2.0)",
  "private": false
}
