{
  "name": "@di-framework/core",
  "version": "5.2.6",
  "description": "Lightweight, zero-dependency TypeScript Dependency Injection framework using decorators. Works seamlessly with SWC and TypeScript's native decorator support.",
  "main": "./dist/container.js",
  "types": "./dist/container.d.ts",
  "module": "./dist/container.js",
  "author": "@di-framework Contributors",
  "license": "(MIT OR Apache-2.0)",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/di-framework",
    "directory": "packages/di-framework-core"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "inversion-of-control",
    "decorators",
    "typescript",
    "swc",
    "framework"
  ],
  "exports": {
    ".": {
      "types": "./dist/container.d.ts",
      "bun": "./dist/container.js",
      "import": "./dist/container.js",
      "default": "./dist/container.js"
    },
    "./container": {
      "types": "./dist/container.d.ts",
      "bun": "./dist/container.js",
      "import": "./dist/container.js",
      "default": "./dist/container.js"
    },
    "./application-context": {
      "types": "./dist/application-context.d.ts",
      "bun": "./dist/application-context.js",
      "import": "./dist/application-context.js",
      "default": "./dist/application-context.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "bun": "./dist/decorators/index.js",
      "import": "./dist/decorators/index.js",
      "default": "./dist/decorators/index.js"
    },
    "./decorators/*": {
      "types": "./dist/decorators/*.d.ts",
      "bun": "./dist/decorators/*.js",
      "import": "./dist/decorators/*.js",
      "default": "./dist/decorators/*.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "bun": "./dist/types.js",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./service-bindings": {
      "types": "./dist/service-bindings/index.d.ts",
      "bun": "./dist/service-bindings/index.js",
      "import": "./dist/service-bindings/index.js",
      "default": "./dist/service-bindings/index.js"
    },
    "./service-bindings/*": {
      "types": "./dist/service-bindings/*.d.ts",
      "bun": "./dist/service-bindings/*.js",
      "import": "./dist/service-bindings/*.js",
      "default": "./dist/service-bindings/*.js"
    }
  },
  "bugs": {
    "url": "https://github.com/di-framework/di-framework/issues"
  },
  "homepage": "https://github.com/di-framework/di-framework#readme",
  "scripts": {
    "build": "rm -rf dist && bun x tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE*",
    "MIGRATION_GUIDE.md"
  ]
}
