{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": ".",
    "incremental": false,
    "allowImportingTsExtensions": false,
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "application-context.ts",
    "container.ts",
    "decorators/**/*.ts",
    "types.ts",
    "service-bindings/**/*.ts"
  ],
  "exclude": ["tests/**"]
}
