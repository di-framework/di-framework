`export class $name { $body }` as $cls where {
  $body <: contains `@Bean($_)`,
  not $cls <: within `@Configuration($_) export class $name { $body }`,
  not $cls <: within `@Configuration export class $name { $body }`,
  register_diagnostic(
    span = $cls,
    severity = "error",
    message = "`@Bean` methods belong on a class decorated with core `@Configuration()`."
  )
}
