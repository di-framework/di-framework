`@WasmCloudBinding($_, { config: { $fields } })` as $binding where {
  or {
    $fields <: contains `password: $_`,
    $fields <: contains `secret: $_`,
    $fields <: contains `token: $_`,
    $fields <: contains `uri: $_`,
    $fields <: contains `url: $_`,
    $fields <: contains `connectionString: $_`,
    $fields <: contains `connectionstring: $_`
  },
  register_diagnostic(
    span = $binding,
    severity = "error",
    message = "Do not put secret material in `@WasmCloudBinding` config. Reference it with `secretFrom`."
  )
}
