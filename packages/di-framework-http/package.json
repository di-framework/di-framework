{
  "name": "@di-framework/http",
  "version": "4.2.3",
  "description": "Extends di-framework with HTTP features",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "author": "@di-framework Contributors",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/di-framework",
    "directory": "packages/di-framework-http"
  },
  "bugs": {
    "url": "https://github.com/di-framework/di-framework/issues"
  },
  "homepage": "https://github.com/di-framework/di-framework#readme",
  "bin": {
    "di-framework-http": "./dist/src/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./index.ts ./src/cli.ts --outdir ./dist --target node --external @di-framework/core --external itty-router && tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "npm run build",
    "dev": "bun ../../examples/http-router/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "itty-router": "^5.0.22"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@di-framework/core": "^4",
    "typescript": "^5"
  }
}
