{
  "name": "@di-framework/auth",
  "version": "4.2.3",
  "description": "Authentication for di-framework — sessions, JWT/JWS bearer, OAuth2/OIDC, and WebAuthn passkeys on WebCrypto with zero runtime dependencies",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webauthn": {
      "types": "./dist/webauthn.d.ts",
      "bun": "./dist/webauthn.js",
      "import": "./dist/webauthn.js",
      "default": "./dist/webauthn.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "bun": "./dist/oauth.js",
      "import": "./dist/oauth.js",
      "default": "./dist/oauth.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "bun": "./dist/http.js",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
      "bun": "./dist/graphql.js",
      "import": "./dist/graphql.js",
      "default": "./dist/graphql.js"
    },
    "./repo": {
      "types": "./dist/repo.d.ts",
      "bun": "./dist/repo.js",
      "import": "./dist/repo.js",
      "default": "./dist/repo.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./dist/server.js",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "author": "@di-framework Contributors",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/di-framework",
    "directory": "packages/di-framework-auth"
  },
  "bugs": {
    "url": "https://github.com/di-framework/di-framework/issues"
  },
  "homepage": "https://github.com/di-framework/di-framework#readme",
  "keywords": [
    "authentication",
    "auth",
    "webauthn",
    "passkeys",
    "oauth2",
    "oidc",
    "jwt",
    "jws",
    "session",
    "webcrypto",
    "dependency-injection",
    "decorators",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./index.ts ./webauthn.ts ./oauth.ts ./http.ts ./graphql.ts ./repo.ts ./server.ts --outdir ./dist --target node --external @di-framework/core --external @di-framework/http --external @di-framework/graphql --external @di-framework/repo --external graphql --external itty-router && tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@di-framework/graphql": "workspace:*",
    "@di-framework/http": "workspace:*",
    "@di-framework/repo": "workspace:*",
    "@types/bun": "latest",
    "graphql": "^17.0.2",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@di-framework/core": "^4",
    "@di-framework/graphql": "^4",
    "@di-framework/http": "^4",
    "@di-framework/repo": "^4",
    "graphql": "^16.8.0 || ^17.0.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@di-framework/graphql": {
      "optional": true
    },
    "@di-framework/http": {
      "optional": true
    },
    "@di-framework/repo": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  }
}
