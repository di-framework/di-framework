{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "skipLibCheck": true,
    "plugins": [{ "transform": "@di-framework/tsc" }]
  },
  "include": ["src/**/*.ts"]
}
