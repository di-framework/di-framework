{
  "name": "@di-framework/tsc",
  "version": "4.2.3",
  "description": "ttsc transform that injects runtime parameter checks from TypeScript types (assertAll)",
  "author": "@di-framework Contributors",
  "license": "(MIT OR Apache-2.0)",
  "private": false,
  "type": "commonjs",
  "main": "plugin.cjs",
  "exports": {
    ".": "./plugin.cjs"
  },
  "ttsc": {
    "plugin": {
      "transform": "@di-framework/tsc"
    }
  },
  "files": [
    "plugin.cjs",
    "plugin",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ttsc",
    "ttsc-plugin",
    "tsgo",
    "typescript",
    "runtime-checks",
    "assertAll"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/di-framework",
    "directory": "packages/di-framework-tsc"
  },
  "bugs": {
    "url": "https://github.com/di-framework/di-framework/issues"
  },
  "homepage": "https://github.com/di-framework/di-framework#readme",
  "dependencies": {
    "ttsc": ">=0.25.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun -e \"console.log('@di-framework/tsc: plugin package (plugin.cjs + Go sidecar), no TS5 compile step')\"",
    "pack:check": "npm pack --dry-run",
    "test": "bun test",
    "smoke": "bun run --cwd fixture smoke"
  }
}
