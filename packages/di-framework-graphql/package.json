{
  "name": "@di-framework/graphql",
  "version": "4.2.2",
  "description": "Radically object-oriented, decorator-driven GraphQL for di-framework. Domain objects are the schema; decorators declare semantic exposure, ownership and boundaries.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "bun": "./dist/core.js",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "author": "@di-framework Contributors",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/di-framework",
    "directory": "packages/di-framework-graphql"
  },
  "bugs": {
    "url": "https://github.com/di-framework/di-framework/issues"
  },
  "homepage": "https://github.com/di-framework/di-framework#readme",
  "keywords": [
    "graphql",
    "dependency-injection",
    "decorators",
    "domain-driven-design",
    "bounded-context",
    "code-first",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./index.ts ./core.ts --outdir ./dist --target node --external graphql --external @di-framework/core && tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "npm run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "graphql": "^17.0.2",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@di-framework/core": "workspace:*",
    "graphql": "^16.8.0 || ^17.0.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "graphql": {
      "optional": true
    }
  }
}
